# Copy to .env and fill in. Never commit .env.
# Signs editor configs (QMS gateway) and the document server's callbacks; the portal backend needs it
# only to verify the callback token. 32+ random characters.
JWT_SECRET=<openssl rand -hex 32>
# Service key the portal backend sends to the QMS gateway: Authorization: Bearer <key>.
GATEWAY_API_KEY=<openssl rand -hex 32>
# Document server address as browsers see it (HTTPS reverse proxy), e.g. https://docs.corp.example.kz
OFFICIER_PUBLIC_URL=http://127.0.0.1:8080
# Images: loaded from the release package (docker load) or pulled from your registry.
#OFFICIER_IMAGE=officier:0.2.0
#OFFICIER_GATEWAY_IMAGE=officier-qms-gateway:0.2.0
# Interface for the document server port (the HTTPS reverse proxy connects to it).
#OFFICIER_BIND=127.0.0.1
#OFFICIER_PORT=8080
# Interface for the QMS gateway: reachable by the portal backend only, never by browsers.
#GATEWAY_BIND=127.0.0.1
#GATEWAY_PORT=8081
# DocService heap in MB; empty = 60% of container memory. Documents open for editing ~ (heap - 256) / 20.
#OFFICIER_DOCSERVICE_HEAP_MB=
# Time zone of decision dates on the approval sheet of the approved PDF.
#QMS_TIME_ZONE=Asia/Almaty
